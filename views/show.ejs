<% layout('layouts/boilerplate') %>
<% const grievanceList = locals.grievances || []; %>
<div class="complaints-wrapper">
  
  <header class="page-header">
    <div class="page-title">
      <h1>All Public Grievances</h1>
      <p>Viewing your reported issues</p>
    </div>
    <a href="/dashboard" class="filter-btn" style="text-decoration: none;">← Back to Dashboard</a>
  </header>

  <div class="toolbar">
    <input type="text" class="search-input" placeholder="Search complaints by keyword or location...">
    <select class="filter-btn">
      <option value="">All Statuses</option>
      <option value="reported">Reported</option>
      <option value="progress">In Progress</option>
      <option value="resolved">Resolved</option>
    </select>
    <select class="filter-btn">
      <option value="">Sort by: Most Votes</option>
      <option value="">Sort by: Newest First</option>
    </select>
  </div>

  <div class="complaints-grid">
    <% if (locals.error) { %>
      <p><%= locals.error %></p>
    <% } else if (grievanceList.length === 0) { %>
      <p>No grievances have been submitted yet.</p>
    <% } %>

    <% grievanceList.forEach(function(grievance) { %>
    <div class="complaint-card">
      <% if (grievance.image_path) { %>
        <img class="complaint-photo" src="<%= grievance.image_path %>" alt="Grievance evidence">
      <% } %>
      
      <div class="complaint-content">
        <div class="complaint-top-row">
          <h3 class="complaint-title"><%= grievance.grievance_category || 'Grievance' %></h3>
          <span class="status-badge status-reported">Submitted</span>
        </div>
        
        <div class="complaint-meta">
          <span><%= grievance.location || 'Location not provided' %></span>
          <span>•</span>
          <span><%= new Date(grievance.created_at).toLocaleString() %></span>
        </div>
        
        <p class="complaint-description">
          <%= grievance.description %>
        </p>

        <!-- NEW: Action Row with Voting System -->
        <div class="card-actions">
          <div class="vote-widget">
            <!-- In EJS, you might wrap this button in a <form> pointing to your POST route -->
            <span>Submission ID: <%= grievance.submission_id %></span>
          </div>
        </div>
        
        <div class="complaint-footer">
          <div class="user-info">
            <div class="user-avatar">AK</div>
            <div class="user-details">
              <h4><%= grievance.grievance_type || 'Citizen submission' %></h4>
              <span>User ID: <%= grievance.user_id %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% }) %>
  </div>
</div>