<% layout('layouts/boilerplate') %>
<div class="auth-wrapper">
  <div class="main-container">
    
    <div class="left-panel">
        <div class="left-content">
            <div class="welcome-heading-row">
              <h1>Welcome Back!</h1>
              <a href="/official" class="officer-login-btn">
                <i class="fa-solid fa-building-shield" aria-hidden="true"></i>
                PG Officer Login
              </a>
            </div>
            <p>Sign in to access your account and manage your activities.</p>
            <img src="/assets/register.png" alt="Login Illustration" class="login-img">
        </div>
    </div>

    <div class="right-panel">
      
      <div class="right-header">
        <div class="logo-area">
          <div class="logo-icon"></div>
          PG-portal
        </div>
        <a href="/login" class="sign-up-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
         Log in
        </a>
      </div>

      <div class="form-container">
        <h2>Sign up</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-msg"><%= error %></div>
        <% } %>

        <% if (typeof message !== 'undefined' && message) { %>
          <div class="success-msg"><%= message %></div>
        <% } %>

        <form action="/signup" method="POST">
          <div class="input-group">
            <input type="text" name="email" placeholder="Email" required>
          </div>

          <div class="input-group">
            <input type="text" name="username" placeholder="Username" required>
          </div>
          
          <div class="input-group">
            <input type="password" name="password" placeholder="Password" required>
          </div>

          <a href="/forgot-password" class="forgot-password">Forgot password?</a>

          <button type="submit" class="btn-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
            Sign up
          </button>
        </form>
      </div>

      <div class="right-footer">
        <div>© 2026-2027 Pg portal.inc</div>
        <div class="footer-links">
          <a href="#">Contact Us</a>
          <a href="#">English ⌄</a>
        </div>
      </div>

    </div>
  </div>
</div>