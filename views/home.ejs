<% layout('layouts/boilerplate') %>
<section class="hero">
        <div class="hero-content">
            <span class="tag">Evidence-Grounded. People-Powered.</span>
            <h1 class="hero-title">A Smarter Way to Build Better Communities</h1>
            <p class="hero-subtitle">Report civic issues, track resolution, and participate in budgeting decisions — all in one transparent, multilingual platform.</p>
            
            <div class="hero-buttons">
                <a href="#" class="btn btn-primary">
                    <i class="fa-regular fa-pen-to-square"></i> Report an Issue
                </a>
                <a href="/dashhome" class="btn btn-outline">
                    <i class="fa-solid fa-chart-line"></i> Explore Dashboard
                </a>
            </div>
            
            <div class="privacy-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Your identity is protected. Always.</span>
            </div>
        </div>

        <div class="slide-animation">
            <button type="button" class="slide-arrow slide-arrow-prev" aria-label="Previous complaint">&#10094;</button>
            <button type="button" class="slide-arrow slide-arrow-next" aria-label="Next complaint">&#10095;</button>

            <article class="slide-card">
                <img src="/assets/newbg.png" alt="Community road improvement" class="slide-image">
                <div class="slide-card-content">
                    <div class="slide-card-heading">
                        <h2>Massive Pothole on 5th Main</h2>
                        <span class="slide-status status-progress">In Progress</span>
                    </div>
                    <p class="slide-location">HSR Layout, Sector 2</p>
                    <p class="slide-description">A deep pothole is creating traffic risk for local residents.</p>
                </div>
            </article>

            <article class="slide-card">
                <img src="/assets/newbg.png" alt="Community cleanliness service" class="slide-image">
                <div class="slide-card-content">
                    <div class="slide-card-heading">
                        <h2>Garbage Dump Overflow</h2>
                        <span class="slide-status status-reported">Reported</span>
                    </div>
                    <p class="slide-location">Kukatpally, Phase 1</p>
                    <p class="slide-description">Overflowing waste is affecting health and cleanliness in the area.</p>
                </div>
            </article>

            <article class="slide-card">
                <img src="/assets/newbg.png" alt="Public water infrastructure" class="slide-image">
                <div class="slide-card-content">
                    <div class="slide-card-heading">
                        <h2>Broken Water Pipe</h2>
                        <span class="slide-status status-resolved">Resolved</span>
                    </div>
                    <p class="slide-location">Gachibowli, Block C</p>
                    <p class="slide-description">A public water supply issue has been resolved by the municipality.</p>
                </div>
            </article>
        </div>

        <script src="/js/home.js" defer></script>
        
    </section>

    <section class="features">
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-language"></i></div>
            <div class="feature-text">
                <h3>Multilingual & Multimodal</h3>
                <p>Report via text, voice or images in your preferred language.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-microchip"></i></div>
            <div class="feature-text">
                <h3>Evidence-Driven Triage</h3>
                <p>AI identifies duplicates and aggregates patterns for faster resolution.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-building-columns"></i></div>
            <div class="feature-text">
                <h3>Right to the Right Desk</h3>
                <p>Issues are routed to the responsible authorities automatically.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-users"></i></div>
            <div class="feature-text">
                <h3>Participatory Budgeting</h3>
                <p>Propose, discuss and vote on local works that matter.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-shield"></i></div>
            <div class="feature-text">
                <h3>Identity Protection</h3>
                <p>Your identity stays safe and confidential.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <div class="feature-text">
                <h3>Transparent Tracking</h3>
                <p>Track every step. From report to resolution.</p>
            </div>
        </div>
    </section>

    <section class="how-it-works">
        <h2>How it works</h2>
        <div class="steps-container">
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                <h3>1. Report</h3>
                <p>Share issues via text, voice or images.</p>
            </div>
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-microchip"></i></div>
                <h3>2. Analyze</h3>
                <p>AI detects duplicates and understands severity.</p>
            </div>
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-network-wired"></i></div>
                <h3>3. Route</h3>
                <p>Automatically sent to the right department.</p>
            </div>
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-eye"></i></div>
                <h3>4. Track</h3>
                <p>Follow progress in real-time with updates.</p>
            </div>
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-chart-bar"></i></div>
                <h3>5. Resolve</h3>
                <p>Issues are resolved and publicly recorded.</p>
            </div>
            <div class="step">
                <div class="step-icon"><i class="fa-solid fa-people-group"></i></div>
                <h3>6. Participate</h3>
                <p>Help prioritize works through budgeting and feedback.</p>
            </div>
        </div>
    </section>

    <section class="stats">
        <div class="stat-item">
            <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
            <div class="stat-text">
                <h4>12,450+</h4>
                <p>Active Citizens</p>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="fa-solid fa-file-invoice"></i></div>
            <div class="stat-text">
                <h4>8,320+</h4>
                <p>Issues Reported</p>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="fa-regular fa-circle-check"></i></div>
            <div class="stat-text">
                <h4>6,102+</h4>
                <p>Issues Resolved</p>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="fa-solid fa-building-columns"></i></div>
            <div class="stat-text">
                <h4>34</h4>
                <p>Partner Departments</p>
            </div>
        </div>
    </section>