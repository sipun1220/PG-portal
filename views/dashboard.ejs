<% layout('layouts/boilerplate') %>

<% 
  // Professional Example Data
  const activeList = locals.activeComplaints || [
    { 
      id: "GRV-8273", 
      title: "Deep Pothole causing traffic delay", 
      date: "Aug 12, 2026", 
      status: "In Progress", 
      statusClass: "status-progress" 
    },
    { 
      id: "GRV-8291", 
      title: "Streetlights not functioning", 
      date: "Aug 18, 2026", 
      status: "Pending Review", 
      statusClass: "status-pending" 
    }
  ];

  const resolvedList = locals.resolvedComplaints || [
    { 
      title: "Underground Pipe Leak Fixed", 
      location: "Sector 14, Main Arterial Road", 
      dept: "Water & Sanitation", 
      date: "July 24, 2026", 
      img: "https://images.unsplash.com/photo-1541888062835-251f28b4d890?q=80&w=400&auto=format&fit=crop",
      notes: "Excavation completed, damaged PVC replaced, and road repaved."
    },
    { 
      title: "Cleared Illegal Dump Site", 
      location: "Northwood Community Park", 
      dept: "Waste Management", 
      date: "July 10, 2026", 
      img: "https://images.unsplash.com/photo-1611284446314-60a58ac0deb9?q=80&w=400&auto=format&fit=crop",
      notes: "Debris removed. Warning signs and CCTV installed to prevent recurrence."
    }
  ];
%>

<div class="civic-wrapper">
  
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <h2>CivicPortal</h2>
    </div>
    <nav class="nav-menu">
      <a href="/civicform" class="nav-item">
        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        <span>File a Grievance</span>
      </a>
      <a href="/show" class="nav-item">
        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Public Activity</span>
      </a>
      <a href="/profile/edit" class="nav-item">
        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        <span>My Profile</span>
      </a>
    </nav>
    <a href="/logout" class="nav-item logout">
      <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
      <span>Sign Out</span>
    </a>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    
    <!-- Active Complaints -->
    <h2 class="section-title">Active Complaints</h2>
    <div class="active-list">
      
      <% activeList.forEach(function(complaint) { %>
      <div class="active-card">
        <div class="active-info">
          <h3><%= complaint.title %></h3>
          <div class="active-meta">
            <span>ID: <%= complaint.id %></span>
            <span>•</span>
            <span>Submitted: <%= complaint.date %></span>
            <span>•</span>
            <span class="badge <%= complaint.statusClass %>"><%= complaint.status %></span>
          </div>
        </div>
        <div class="btn-group">
          <button class="btn btn-secondary">
            <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            Renew
          </button>
          <button class="btn btn-primary">
            <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            View Status
          </button>
        </div>
      </div>
      <% }) %>

    </div>

    <!-- Resolved Complaints -->
    <h2 class="section-title">Resolved History</h2>
    <div class="resolved-grid">
      
      <% resolvedList.forEach(function(complaint) { %>
      <div class="resolved-card">
        <div class="card-img-wrapper">
          <img src="<%= complaint.img %>" alt="Resolved Issue" class="card-img">
          <span class="status-ribbon">Resolved</span>
        </div>
        
        <div class="card-body">
          <h4><%= complaint.title %></h4>
          
          <div class="data-row">
            <svg class="data-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span><%= complaint.location %></span>
          </div>
          
          <div class="data-row">
            <svg class="data-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <span><strong>Department:</strong> <%= complaint.dept %></span>
          </div>
          
          <div class="data-row">
            <svg class="data-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span><strong>Fixed on:</strong> <%= complaint.date %></span>
          </div>

          <div class="card-notes">
            <%= complaint.notes %>
          </div>
        </div>
      </div>
      <% }) %>

    </div>
  </main>
</div>